# Copy to .env (setup.ps1 does this and fills the two secrets below for you).

# --- secrets (setup.ps1 generates these) ---------------------------------
POSTGRES_PASSWORD=
MEM0_SERVER_KEY=

# --- ports ----------------------------------------------------------------
MEM0_PORT=8765

# --- models --------------------------------------------------------------
# Nothing to fill in here: Noch sends the chat provider you configured in its
# settings (address, key, models) with every request, and this server uses it for
# fact extraction and embeddings. The values below are only a FALLBACK for other
# clients that call this server without a provider (any OpenAI-compatible one).
#MEM0_LLM_BASE_URL=https://api.openai.com/v1
#MEM0_LLM_MODEL=gpt-4o-mini
#MEM0_LLM_API_KEY=
#MEM0_EMBED_MODEL=text-embedding-3-small
#MEM0_EMBED_BASE_URL=
#MEM0_EMBED_API_KEY=
#MEM0_EMBED_DIMS=        # measured automatically when blank

# --- optional ---------------------------------------------------------------
#MEM0_COLLECTION=noch_memories
#MEM0_CUSTOM_INSTRUCTIONS=
